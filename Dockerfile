FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html tsconfig*.json vite.config.ts app.config.mjs ./
COPY src ./src
COPY public ./public
ARG APP_EDITION=core
ARG META_API_ENABLED=true
ARG GEMINI_API_ENABLED=false
ARG GEMINI_MOVEMENT_MODEL=
ARG RECIPE_PHOTO_GENERATION_ENABLED=false
ARG VITE_FIREBASE_API_KEY VITE_FIREBASE_AUTH_DOMAIN VITE_FIREBASE_PROJECT_ID VITE_FIREBASE_APP_ID VITE_FIREBASE_MEASUREMENT_ID
ENV META_API_ENABLED=$META_API_ENABLED GEMINI_API_ENABLED=$GEMINI_API_ENABLED GEMINI_MOVEMENT_MODEL=$GEMINI_MOVEMENT_MODEL RECIPE_PHOTO_GENERATION_ENABLED=$RECIPE_PHOTO_GENERATION_ENABLED VITE_FIREBASE_API_KEY=$VITE_FIREBASE_API_KEY VITE_FIREBASE_AUTH_DOMAIN=$VITE_FIREBASE_AUTH_DOMAIN VITE_FIREBASE_PROJECT_ID=$VITE_FIREBASE_PROJECT_ID VITE_FIREBASE_APP_ID=$VITE_FIREBASE_APP_ID VITE_FIREBASE_MEASUREMENT_ID=$VITE_FIREBASE_MEASUREMENT_ID
RUN npm run typecheck && npx vite build --mode "$APP_EDITION"
FROM nginx:1.29-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

