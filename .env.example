AI_PROVIDER=Fireworks AI
AI_BASE_URL=https://api.fireworks.ai/inference/v1
AI_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct
AI_API_KEY=

# Ingredient recognition is configured independently from recipe generation.
# Supported values: META or GEMINI. There is no automatic provider fallback.
RECOGNITION_MODEL_PROVIDER=META
META_MODEL_API_KEY=
META_RECOGNITION_MODEL=muse-spark-1.3
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
RECOGNITION_TIMEOUT_MS=45000

RECIPE_DATASET_CSV=/absolute/path/to/recipes-with-nutrition.csv
RECIPE_EXPECTED_ROWS=39447
USDA_DATA_DIR=/absolute/path/to/usda/csv
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

