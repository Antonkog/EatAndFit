{
  "name": "eat-and-fit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode core",
    "dev:byok": "vite --mode byok",
    "api": "node server/api.mjs",
    "api:byok": "APP_EDITION=byok node server/api.mjs",
    "build": "tsc -b && vite build --mode core",
    "build:byok": "tsc -b && vite build --mode byok",
    "build:editions": "tsc -b && vite build --mode core --outDir dist/core && vite build --mode byok --outDir dist/byok",
    "typecheck": "tsc -b --pretty false",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "latest",
    "@vitejs/plugin-react": "latest",
    "@zxing/browser": "0.1.5",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "@firebase/app": "latest",
    "@firebase/analytics": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tsx": "latest"
  }
}
